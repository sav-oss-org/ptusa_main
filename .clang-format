# PAC/ptusa C++ formatting style, based on Google with overrides that
# reproduce docs/style.md: 80 columns, 4-space indentation, wrapped
# braces indented one extra level with the body aligned to the brace
# (Whitesmiths), spaces inside parentheses and square brackets.
#
# Requires clang-format 23.1.5 (pinned via pip in pre-commit and CI):
#   pip install clang-format==23.1.5
# Older 23.x and 19.x format this codebase within a dozen lines;
# version 21 is unusable because its Whitesmiths support is broken.
#
# PAC/common/PAC_dev_lua.cpp is generated by toluapp and must be kept
# out of the formatting file list (see the pre-commit and CI configs).
---
Language: Cpp
BasedOnStyle: Google
Standard: c++17
ColumnLimit: 80
# Preserve up to two consecutive blank lines so author-made section
# separators survive the run (the Google base keeps only one).
MaxEmptyLinesToKeep: 2
# Keep over-long string literals on the author's line instead of
# re-splitting them into adjacent literals; the tree already splits
# them by hand where it matters (lines may exceed the column limit).
BreakStringLiterals: false
IndentWidth: 4
TabWidth: 4
UseTab: Never
# Whitesmiths wraps every brace onto a new line, indents it one level
# deeper than the statement, and aligns the body with the brace.
BreakBeforeBraces: Whitesmiths
# Access labels sit at the brace column, members one level deeper.
IndentAccessModifiers: true
IndentCaseLabels: true
NamespaceIndentation: All
FixNamespaceComments: false
# The tree has always aligned the values of consecutive #define
# directives (for example the color defines in PAC/linux/l_console.h);
# let clang-format keep those columns tidy.
AlignConsecutiveMacros:
  Enabled: true
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
Cpp11BracedListStyle: false
ContinuationIndentWidth: 4
AlignAfterOpenBracket: DontAlign
ConstructorInitializerAllOnOneLineOrOnePerLine: true
ConstructorInitializerIndentWidth: 4
BreakConstructorInitializers: AfterColon
DerivePointerAlignment: false
PointerAlignment: Left
SortIncludes: Never
SpaceBeforeParens: ControlStatements
SpacesInParentheses: true
SpacesInSquareBrackets: true
SpaceInEmptyParentheses: false
SpacesInCStyleCastParentheses: false
SpacesInAngles: Leave
ReflowComments: false
# Always never reaches a fixed point for multi-line braced
# initializers followed by ///< comments: the two options fight
# over comment column, so leave placement to the author.
AlignTrailingComments: Leave
IndentPPDirectives: None
