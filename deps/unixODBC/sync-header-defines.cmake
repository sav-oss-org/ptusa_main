if(NOT DEFINED UNIXODBC_DIR)
    message(FATAL_ERROR "UNIXODBC_DIR not set")
endif()

# config.status leaves unixodbc.h/unixodbc_conf.h's "#undef SYMBOL" lines
# unsubstituted even though the detected values exist in config.h. Copy the
# real "#define SYMBOL ..." lines from config.h over the matching "#undef"
# placeholders so public headers (e.g. sqltypes.h's SIZEOF_LONG_INT check)
# see the real values.
file(STRINGS "${UNIXODBC_DIR}/config.h" _config_lines)
set(_symbols "")
foreach(_line IN LISTS _config_lines)
    if(_line MATCHES "^#define[ \t]+([A-Za-z_][A-Za-z0-9_]*)")
        set(_sym "${CMAKE_MATCH_1}")
        list(APPEND _symbols "${_sym}")
        set(_define_line_${_sym} "${_line}")
    endif()
endforeach()

foreach(_header_name "unixodbc.h" "unixodbc_conf.h")
    set(_path "${UNIXODBC_DIR}/${_header_name}")
    if(NOT EXISTS "${_path}")
        continue()
    endif()
    file(STRINGS "${_path}" _header_lines)
    set(_out_lines "")
    set(_changed FALSE)
    foreach(_line IN LISTS _header_lines)
        set(_new_line "${_line}")
        if(_line MATCHES "^#undef[ \t]+([A-Za-z_][A-Za-z0-9_]*)[ \t]*$")
            set(_sym "${CMAKE_MATCH_1}")
            list(FIND _symbols "${_sym}" _idx)
            if(NOT _idx EQUAL -1)
                set(_new_line "${_define_line_${_sym}}")
                set(_changed TRUE)
            endif()
        endif()
        list(APPEND _out_lines "${_new_line}")
    endforeach()
    if(_changed)
        list(JOIN _out_lines "\n" _out_content)
        file(WRITE "${_path}" "${_out_content}\n")
        message(STATUS "Synced #define values from config.h into ${_header_name}")
    endif()
endforeach()
