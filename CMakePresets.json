{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
  "configurePresets": [
    {
      "name": "windows-VS2026-default",
      "displayName": "Visual Studio Community 2026 - x86 Release",
      "description": "Using compilers for Visual Studio 18 2026 (x86 architecture)",
      "generator": "Visual Studio 18 2026",
      "toolset": "host=x86",
      "architecture": "win32",
      "binaryDir": "${sourceDir}/bin/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/install/windows-VS2026-default"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-VS2026-debug",
      "displayName": "Visual Studio Community 2026 - x86 Debug",
      "description": "Using compilers for Visual Studio 18 2026 (x86 architecture)",
      "inherits": "windows-VS2026-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },


    {
      "name": "linux-default",
      "displayName": "Linux Release",
      "description": "Using default compilers on Linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/bin/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/install/${presetName}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "description": "Using default compilers on Linux",
      "inherits": "linux-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },


    {
      "name": "windows-Mingw64-default",
      "displayName": "Windows MinGW64 Default",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/bin/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },


    {
      "name": "build-windows-AXCF2152-2024-LTS-Release",
      "displayName": "Windows AXCF2152 2024 LTS Release",
      "description": "Using Windows OS",
      "inherits": "windows-AXCF-default",
      "environment": {
        "ARP_DEVICE": "AXCF2152",
        "ARP_DEVICE_VERSION": "2024.0.17 LTS (24.0.17.244)",
        "ARP_DEVICE_SHORT_VERSION": "2024.0",
        "ARP_SDK_PACKAGE_NAME": "x86_64-w64-mingw32"
      }
    },
    {
      "name": "build-windows-AXCF2152-2026-LTS-Release",
      "displayName": "Windows AXCF2152 2026 LTS Release",
      "description": "Using Windows OS",
      "inherits": "windows-AXCF-default",
      "environment": {
        "ARP_DEVICE": "AXCF2152",
        "ARP_DEVICE_VERSION": "2026.0.5 LTS (26.0.5.124)",
        "ARP_DEVICE_SHORT_VERSION": "2026.0",
        "ARP_SDK_PACKAGE_NAME": "x86_64-w64-mingw32"
      }
    },


    {
      "name": "build-linux-AXCF2152-2024-LTS-Release",
      "displayName": "Linux AXCF2152 2024.0 LTS Release",
      "description": "Using Linux OS",
      "inherits": "linux-AXCF-default",
      "environment": {
        "ARP_DEVICE": "AXCF2152",
        "ARP_DEVICE_SHORT_VERSION": "2024.0",
        "ARP_DEVICE_VERSION": "2024.0.17 LTS (24.0.17.244)"
      }
    },
    {
      "name": "build-linux-AXCF2152-2026-LTS-Release",
      "displayName": "Linux AXCF2152 2026.0 LTS Release",
      "description": "Using Linux OS",
      "inherits": "linux-AXCF-default",
      "environment": {
        "ARP_DEVICE": "AXCF2152",
        "ARP_DEVICE_SHORT_VERSION": "2026.0",
        "ARP_DEVICE_VERSION": "2026.0.5 LTS (26.0.5.124)"
      }
    },


    {
      "name": "build-windows-AXCF3152-2024-LTS-Release",
      "displayName": "Windows AXCF3152 2024 LTS Release",
      "description": "Using Windows OS",
      "inherits": "windows-AXCF-default",
      "environment": {
        "ARP_DEVICE": "AXCF3152",
        "ARP_DEVICE_VERSION": "2024.0.9 LTS (24.0.9.163)",
        "ARP_DEVICE_SHORT_VERSION": "2024.0",
        "ARP_SDK_PACKAGE_NAME": "x86_64-w64-mingw32"
      }
    },
    {
      "name": "build-windows-AXCF3152-2026-LTS-Release",
      "displayName": "Windows AXCF3152 2026 LTS Release",
      "description": "Using Windows OS",
      "inherits": "windows-AXCF-default",
      "environment": {
        "ARP_DEVICE": "AXCF3152",
        "ARP_DEVICE_VERSION": "2026.0.3 LTS (26.0.3.88)",
        "ARP_DEVICE_SHORT_VERSION": "2026.0",
        "ARP_SDK_PACKAGE_NAME": "x86_64-w64-mingw32"
      }
    },


    {
      "name": "build-linux-AXCF3152-2024-LTS-Release",
      "displayName": "Linux AXCF3152 2024.0 LTS Release",
      "description": "Using Linux OS",
      "inherits": "linux-AXCF-default",
      "environment": {
        "ARP_DEVICE": "AXCF3152",
        "ARP_DEVICE_SHORT_VERSION": "2024.0",
        "ARP_DEVICE_VERSION": "2024.0.9 LTS (24.0.9.163)",
        "ARP_SDK_PACKAGE_NAME": "x86_64-pokysdk-mingw32"
      }
    },
    {
      "name": "build-linux-AXCF3152-2026-LTS-Release",
      "displayName": "Linux AXCF3152 2026.0 LTS Release",
      "description": "Using Linux OS",
      "inherits": "linux-AXCF-default",
      "environment": {
        "ARP_DEVICE": "AXCF3152",
        "ARP_DEVICE_SHORT_VERSION": "2026.0",
        "ARP_DEVICE_VERSION": "2026.0.3 LTS (26.0.3.88)",
        "ARP_SDK_PACKAGE_NAME": "x86_64-pokysdk-mingw32"
      }
    },


    {
      "name": "linux-AXCF-default",
      "hidden": true,
      "inherits": "AXCF-default",
      "environment": {
        "PLCNEXT_SDK_ROOT": "/opt/pxc/sdks/$env{ARP_DEVICE}/$env{ARP_DEVICE_SHORT_VERSION}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },


    {
      "name": "windows-AXCF-default",
      "hidden": true,
      "inherits": "AXCF-default",
      "generator": "Ninja",
      "environment": {
        "PLCNEXT_SDK_ROOT": "c:/CLI/sdks/$env{ARP_DEVICE}/$env{ARP_DEVICE_SHORT_VERSION}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "AXCF-default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/bin/build/$env{ARP_DEVICE}_$env{ARP_DEVICE_SHORT_VERSION}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/install",
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "$env{PLCNEXT_SDK_ROOT}/toolchain.cmake",
          "type": "FILEPATH"
        },
        "ARP_DEVICE": "$env{ARP_DEVICE}",
        "ARP_DEVICE_VERSION": "$env{ARP_DEVICE_VERSION}"
      }
    }
  ],


  "buildPresets": [
    {
      "name": "build-windows-VS2026-release",
      "displayName": " Windows VS2026 Release",
      "configurePreset": "windows-VS2026-default",
      "configuration": "Release"
    },
    {
      "name": "build-windows-VS2026-debug",
      "displayName": " Windows VS2026 Debug",
      "configurePreset": "windows-VS2026-debug",
      "configuration": "Debug"
    },

    {
      "name": "build-linux-AXCF3152-2024-LTS-Release",
      "displayName": "AXCF3152 2024 LTS",
      "configurePreset": "build-linux-AXCF3152-2024-LTS-Release"
    },
    {
      "name": "build-linux-AXCF3152-2026-LTS-Release",
      "displayName": "AXCF3152 2026 LTS",
      "configurePreset": "build-linux-AXCF3152-2026-LTS-Release"
    },


    {
      "name": "build-windows-AXCF3152-2024-LTS-Release",
      "displayName": "AXCF3152 2024 LTS",
      "configurePreset": "build-windows-AXCF3152-2024-LTS-Release"
    },
    {
      "name": "build-windows-AXCF3152-2026-LTS-Release",
      "displayName": "AXCF3152 2026 LTS",
      "configurePreset": "build-windows-AXCF3152-2026-LTS-Release"
    },


    {
      "name": "build-windows-AXCF2152-2024-LTS-Release",
      "displayName": "AXCF2152 2024 LTS",
      "configurePreset": "build-windows-AXCF2152-2024-LTS-Release"
    },
    {
      "name": "build-windows-AXCF2152-2026-LTS-Release",
      "displayName": "AXCF2152 2026 LTS",
      "configurePreset": "build-windows-AXCF2152-2026-LTS-Release"
    },


    {
      "name": "build-linux-AXCF2152-2024-LTS-Release",
      "displayName": "AXCF2152 2024 LTS",
      "configurePreset": "build-linux-AXCF2152-2024-LTS-Release"
    },
    {
      "name": "build-linux-AXCF2152-2026-LTS-Release",
      "displayName": "AXCF2152 2026 LTS",
      "configurePreset": "build-linux-AXCF2152-2026-LTS-Release"
    },


    {
      "name": "build-linux-Release",
      "displayName": "Linux Release",
      "configurePreset": "linux-default"
    },
    {
      "name": "build-linux-Debug",
      "displayName": "Linux Debug",
      "configurePreset": "linux-debug"
    }
  ]
}
