# How to run every preset pair available on this machine:
# cmake -P ./misc/bi_all.cmake
# To only list the discovered presets and pairs, without building:
# cmake -D LIST_ONLY=true -P ./misc/bi_all.cmake
# To run only configure presets whose name matches a regular expression:
# cmake -D CFG_FILTER:string="^windows-VS" -P ./misc/bi_all.cmake

# CMake port of misc/bi_all.sh. Runs natively wherever CMake runs:
# no sh and no Python are required. It discovers configure
# presets in CMakePresets.json (and in CMakeUserPresets.json when
# present), keeps the ones whose condition accepts this host, pairs
# each of them with the build presets that reference it, and runs
# bi.cmake for every pair. Per-preset and total timings are printed
# with cmake_echo_color, as bi_all.sh and bi.cmake do with colors.
#
# Note: standard execute_process() runs its COMMAND list as one
# pipeline, not side by side, and has no PARALLEL option (checked
# against CMake 4.4). Pairs are therefore processed sequentially.
#
# This script resolves only the two standard preset files. A non-empty
# top-level "include" array and the plural "configurePresets" field of
# build presets are rejected with an error instead of being guessed.

# Save start time.
string(TIMESTAMP t_all "%s")

get_filename_component(repo_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(bi_script "${CMAKE_CURRENT_LIST_DIR}/bi.cmake")
if(NOT EXISTS "${repo_root}/CMakePresets.json")
    message(FATAL_ERROR "CMakePresets.json not found at ${repo_root}.")
endif()
if(NOT EXISTS "${bi_script}")
    message(FATAL_ERROR "bi.cmake not found next to bi_all.cmake.")
endif()

# Print one line with cmake_echo_color, keeping bi.cmake's style.
function(echo_color color bold text)
    if(bold)
        set(bold_arg --bold)
    else()
        set(bold_arg "")
    endif()
    execute_process(COMMAND
        ${CMAKE_COMMAND} -E env CLICOLOR_FORCE=1
        ${CMAKE_COMMAND} -E cmake_echo_color --${color} ${bold_arg} "${text}")
endfunction()

# Expand the condition macros of the presets schema: ${hostSystemName},
# $env{...} and $penv{...}.
function(expand_macros input output)
    set(text "${input}")
    string(REPLACE "\${hostSystemName}" "${CMAKE_HOST_SYSTEM_NAME}"
        text "${text}")
    set(guard 0)
    while(text MATCHES "\$p?env\{[^}]*\}")
        math(EXPR guard "${guard} + 1")
        if(guard GREATER 32)
            message(FATAL_ERROR "Too many env macros in '${input}'.")
        endif()
        string(REGEX MATCH "\$p?env\{([^}]*)\}" token "${text}")
        string(REPLACE "${token}" "$ENV{${CMAKE_MATCH_1}}" text "${text}")
    endwhile()
    set(${output} "${text}" PARENT_SCOPE)
endfunction()

# Evaluate one presets condition in boolean, null or object form.
function(eval_condition cond_json out_var)
    string(JSON kind TYPE "${cond_json}")
    if(kind STREQUAL "BOOLEAN")
        string(JSON val GET "${cond_json}")
        if(val)
            set(res TRUE)
        else()
            set(res FALSE)
        endif()
    elseif(kind STREQUAL "NULL")
        # A null condition enables the preset.
        set(res TRUE)
    elseif(kind STREQUAL "OBJECT")
        string(JSON ctype ERROR_VARIABLE err GET "${cond_json}" "type")
        if(err)
            set(ctype "")
        endif()
        if(ctype STREQUAL "equals" OR ctype STREQUAL "notEquals")
            string(JSON lhs GET "${cond_json}" "lhs")
            string(JSON rhs GET "${cond_json}" "rhs")
            expand_macros("${lhs}" lhs)
            expand_macros("${rhs}" rhs)
            if(lhs STREQUAL rhs)
                set(res TRUE)
            else()
                set(res FALSE)
            endif()
            if(ctype STREQUAL "notEquals")
                if(res)
                    set(res FALSE)
                else()
                    set(res TRUE)
                endif()
            endif()
        elseif(ctype STREQUAL "const")
            string(JSON val GET "${cond_json}" "value")
            if(val)
                set(res TRUE)
            else()
                set(res FALSE)
            endif()
        elseif(ctype STREQUAL "inList" OR ctype STREQUAL "notInList")
            string(JSON str GET "${cond_json}" "string")
            expand_macros("${str}" str)
            string(JSON n LENGTH "${cond_json}" "list")
            set(found FALSE)
            if(n GREATER 0)
                math(EXPR last "${n} - 1")
                foreach(i RANGE 0 ${last})
                    string(JSON item GET "${cond_json}" "list" ${i})
                    expand_macros("${item}" item)
                    if(item STREQUAL str)
                        set(found TRUE)
                    endif()
                endforeach()
            endif()
            if(ctype STREQUAL "inList")
                set(res ${found})
            elseif(found)
                set(res FALSE)
            else()
                set(res TRUE)
            endif()
        elseif(ctype STREQUAL "matches" OR ctype STREQUAL "notMatches")
            string(JSON str GET "${cond_json}" "string")
            string(JSON rex GET "${cond_json}" "regex")
            expand_macros("${str}" str)
            expand_macros("${rex}" rex)
            if(str MATCHES "${rex}")
                set(res TRUE)
            else()
                set(res FALSE)
            endif()
            if(ctype STREQUAL "notMatches")
                if(res)
                    set(res FALSE)
                else()
                    set(res TRUE)
                endif()
            endif()
        elseif(ctype STREQUAL "anyOf" OR ctype STREQUAL "allOf")
            if(ctype STREQUAL "anyOf")
                set(res FALSE)
            else()
                set(res TRUE)
            endif()
            string(JSON n LENGTH "${cond_json}" "conditions")
            if(n GREATER 0)
                math(EXPR last "${n} - 1")
                foreach(i RANGE 0 ${last})
                    string(JSON sub GET "${cond_json}" "conditions" ${i})
                    eval_condition("${sub}" subres)
                    if(ctype STREQUAL "anyOf")
                        if(subres)
                            set(res TRUE)
                        endif()
                    elseif(NOT subres)
                        set(res FALSE)
                    endif()
                endforeach()
            endif()
        elseif(ctype STREQUAL "not")
            string(JSON sub GET "${cond_json}" "condition")
            eval_condition("${sub}" res)
            if(res)
                set(res FALSE)
            else()
                set(res TRUE)
            endif()
        else()
            message(WARNING
                "Condition type '${ctype}' is not supported, assumed true.")
            set(res TRUE)
        endif()
    else()
        message(FATAL_ERROR
            "Condition must be boolean, null or object, not ${kind}.")
    endif()
    set(${out_var} ${res} PARENT_SCOPE)
endfunction()

# Resolve the effective availability of every preset: its own condition
# AND the availability of all presets it inherits from, transitively.
function(resolve_availability names owns pars out_var)
    list(LENGTH names count)
    if(count EQUAL 0)
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    set(avail "")
    math(EXPR pre_last "${count} - 1")
    foreach(pre_i RANGE 0 ${pre_last})
        list(APPEND avail "?")
    endforeach()
    set(progress TRUE)
    while(progress)
        set(progress FALSE)
        math(EXPR last "${count} - 1")
        foreach(i RANGE 0 ${last})
            list(GET avail ${i} state)
            if(NOT state STREQUAL "?")
                continue()
            endif()
            list(GET owns ${i} own)
            list(GET pars ${i} par)
            set(parents "")
            if(NOT par STREQUAL "-")
                string(REPLACE "|" ";" parents "${par}")
            endif()
            set(known TRUE)
            set(ok ${own})
            foreach(parent ${parents})
                list(FIND names "${parent}" pidx)
                if(pidx LESS 0)
                    message(FATAL_ERROR
                        "Preset inherits '${parent}', which no loaded "
                        "preset file defines.")
                endif()
                list(GET avail ${pidx} pstate)
                if(pstate STREQUAL "?")
                    set(known FALSE)
                elseif(NOT pstate)
                    set(ok FALSE)
                endif()
            endforeach()
            if(known)
                if(ok)
                    set(ok TRUE)
                else()
                    set(ok FALSE)
                endif()
                list(REMOVE_AT avail ${i})
                list(INSERT avail ${i} ${ok})
                set(progress TRUE)
            endif()
        endforeach()
        set(done TRUE)
        foreach(state ${avail})
            if(state STREQUAL "?")
                set(done FALSE)
            endif()
        endforeach()
        if(done)
            break()
        endif()
        if(NOT progress)
            message(FATAL_ERROR "Cyclic inherits chain in presets.")
        endif()
    endwhile()
    set(${out_var} ${avail} PARENT_SCOPE)
endfunction()

# Print a preset table like cmake --list-presets does: quoted names
# padded to a common width, followed by an optional display name.
function(print_table names disps header)
    message("")
    message("${header}")
    message("")
    list(LENGTH names count)
    if(count EQUAL 0)
        return()
    endif()
    math(EXPR last "${count} - 1")
    set(width 0)
    foreach(i RANGE 0 ${last})
        list(GET names ${i} name)
        string(LENGTH "\"${name}\"" len)
        if(len GREATER width)
            set(width ${len})
        endif()
    endforeach()
    set(j 0)
    foreach(name ${names})
        set(disp "")
        if(j LESS count)
            list(GET disps ${j} disp)
        endif()
        math(EXPR j "${j} + 1")
        string(LENGTH "\"${name}\"" len)
        math(EXPR pad "${width} - ${len}")
        set(spaces "")
        if(pad GREATER 0)
            string(RANDOM LENGTH ${pad} ALPHABET " " spaces)
        endif()
        if(disp STREQUAL "" OR disp STREQUAL "__nodisp__")
            message("  \"${name}\"")
        else()
            message("  \"${name}\"${spaces} - ${disp}")
        endif()
    endforeach()
endfunction()

# Load both standard preset files. The later file wins for duplicate
# names, and a duplicate moves to the end of its table. Every table is
# a set of parallel lists: names, display names, hidden flags, own
# condition results and inherits chains joined with "|".  Empty list
# items are dropped by list(APPEND), so empty display names become
# "__nodisp__", empty inherits chains and links become "-".
set(preset_files "${repo_root}/CMakePresets.json")
if(EXISTS "${repo_root}/CMakeUserPresets.json")
    list(APPEND preset_files "${repo_root}/CMakeUserPresets.json")
endif()

set(cfg_names "")
set(cfg_disps "")
set(cfg_hiddens "")
set(cfg_owns "")
set(cfg_pars "")
set(bld_names "")
set(bld_disps "")
set(bld_hiddens "")
set(bld_owns "")
set(bld_pars "")
set(bld_links "")

foreach(file ${preset_files})
    file(READ "${file}" json)

    string(JSON itype ERROR_VARIABLE err TYPE "${json}" "include")
    if(NOT err AND NOT itype STREQUAL "ARRAY")
        message(FATAL_ERROR "Top-level include in ${file} is not an array.")
    endif()
    if(NOT err)
        string(JSON nincl LENGTH "${json}" "include")
        if(nincl GREATER 0)
            message(FATAL_ERROR
                "Top-level include array of ${file} is not supported.")
        endif()
    endif()

    # Configure presets.
    string(JSON atype ERROR_VARIABLE err TYPE "${json}" "configurePresets")
    if(NOT err AND atype STREQUAL "ARRAY")
        string(JSON n LENGTH "${json}" "configurePresets")
        if(n GREATER 0)
            math(EXPR last "${n} - 1")
            foreach(i RANGE 0 ${last})
                string(JSON p GET "${json}" "configurePresets" ${i})
                string(JSON name ERROR_VARIABLE err GET "${p}" "name")
                if(err)
                    message(FATAL_ERROR
                        "configurePresets entry ${i} of ${file} has no name.")
                endif()
                string(REPLACE ";" "|" name "${name}")
                string(JSON disp ERROR_VARIABLE err GET "${p}" "displayName")
                if(err)
                    set(disp "")
                endif()
                string(REPLACE ";" "|" disp "${disp}")
                if(disp STREQUAL "")
                    set(disp "__nodisp__")
                endif()
                string(JSON hid ERROR_VARIABLE err TYPE "${p}" "hidden")
                if(err OR NOT hid STREQUAL "BOOLEAN")
                    set(hid FALSE)
                else()
                    string(JSON hid GET "${p}" "hidden")
                    if(hid)
                        set(hid TRUE)
                    else()
                        set(hid FALSE)
                    endif()
                endif()
                string(JSON ckind ERROR_VARIABLE err TYPE "${p}" "condition")
                if(err OR ckind STREQUAL "NULL")
                    set(own TRUE)
                elseif(ckind STREQUAL "BOOLEAN")
                    string(JSON cval GET "${p}" "condition")
                    if(cval)
                        set(own TRUE)
                    else()
                        set(own FALSE)
                    endif()
                elseif(ckind STREQUAL "OBJECT")
                    string(JSON cval GET "${p}" "condition")
                    eval_condition("${cval}" own)
                else()
                    message(FATAL_ERROR
                        "Preset '${name}' has a ${ckind} condition.")
                endif()
                string(JSON ptype ERROR_VARIABLE err TYPE "${p}" "inherits")
                set(par "")
                if(NOT err AND ptype STREQUAL "STRING")
                    string(JSON item GET "${p}" "inherits")
                    set(par "${item}")
                elseif(NOT err AND ptype STREQUAL "ARRAY")
                    string(JSON np LENGTH "${p}" "inherits")
                    if(np GREATER 0)
                        math(EXPR ilast "${np} - 1")
                        foreach(ii RANGE 0 ${ilast})
                            string(JSON item GET "${p}" "inherits" ${ii})
                            if(par STREQUAL "")
                                set(par "${item}")
                            else()
                                string(APPEND par "|${item}")
                            endif()
                        endforeach()
                    endif()
                endif()
                string(REPLACE ";" "|" par "${par}")
                if(par STREQUAL "")
                    set(par "-")
                endif()
                list(FIND cfg_names "${name}" idx)
                if(NOT idx LESS 0)
                    list(REMOVE_AT cfg_names ${idx})
                    list(REMOVE_AT cfg_disps ${idx})
                    list(REMOVE_AT cfg_hiddens ${idx})
                    list(REMOVE_AT cfg_owns ${idx})
                    list(REMOVE_AT cfg_pars ${idx})
                endif()
                list(APPEND cfg_names "${name}")
                list(APPEND cfg_disps "${disp}")
                list(APPEND cfg_hiddens "${hid}")
                list(APPEND cfg_owns "${own}")
                list(APPEND cfg_pars "${par}")
            endforeach()
        endif()
    endif()

    # Build presets.
    string(JSON btype ERROR_VARIABLE err TYPE "${json}" "buildPresets")
    if(NOT err AND btype STREQUAL "ARRAY")
        string(JSON n LENGTH "${json}" "buildPresets")
        if(n GREATER 0)
            math(EXPR last "${n} - 1")
            foreach(i RANGE 0 ${last})
                string(JSON p GET "${json}" "buildPresets" ${i})
                string(JSON name ERROR_VARIABLE err GET "${p}" "name")
                if(err)
                    message(FATAL_ERROR
                        "buildPresets entry ${i} of ${file} has no name.")
                endif()
                string(REPLACE ";" "|" name "${name}")
                string(JSON disp ERROR_VARIABLE err GET "${p}" "displayName")
                if(err)
                    set(disp "")
                endif()
                string(REPLACE ";" "|" disp "${disp}")
                if(disp STREQUAL "")
                    set(disp "__nodisp__")
                endif()
                string(JSON hid ERROR_VARIABLE err TYPE "${p}" "hidden")
                if(err OR NOT hid STREQUAL "BOOLEAN")
                    set(hid FALSE)
                else()
                    string(JSON hid GET "${p}" "hidden")
                    if(hid)
                        set(hid TRUE)
                    else()
                        set(hid FALSE)
                    endif()
                endif()
                string(JSON ckind ERROR_VARIABLE err TYPE "${p}" "condition")
                if(err OR ckind STREQUAL "NULL")
                    set(own TRUE)
                elseif(ckind STREQUAL "BOOLEAN")
                    string(JSON cval GET "${p}" "condition")
                    if(cval)
                        set(own TRUE)
                    else()
                        set(own FALSE)
                    endif()
                elseif(ckind STREQUAL "OBJECT")
                    string(JSON cval GET "${p}" "condition")
                    eval_condition("${cval}" own)
                else()
                    message(FATAL_ERROR
                        "Build preset '${name}' has a ${ckind} condition.")
                endif()
                string(JSON ptype ERROR_VARIABLE err TYPE "${p}" "inherits")
                set(par "")
                if(NOT err AND ptype STREQUAL "STRING")
                    string(JSON item GET "${p}" "inherits")
                    set(par "${item}")
                elseif(NOT err AND ptype STREQUAL "ARRAY")
                    string(JSON np LENGTH "${p}" "inherits")
                    if(np GREATER 0)
                        math(EXPR ilast "${np} - 1")
                        foreach(ii RANGE 0 ${ilast})
                            string(JSON item GET "${p}" "inherits" ${ii})
                            if(par STREQUAL "")
                                set(par "${item}")
                            else()
                                string(APPEND par "|${item}")
                            endif()
                        endforeach()
                    endif()
                endif()
                string(REPLACE ";" "|" par "${par}")
                if(par STREQUAL "")
                    set(par "-")
                endif()
                string(JSON ltype ERROR_VARIABLE err
                    TYPE "${p}" "configurePreset")
                if(NOT err AND ltype STREQUAL "STRING")
                    string(JSON link GET "${p}" "configurePreset")
                    string(REPLACE ";" "|" link "${link}")
                else()
                    set(link "")
                endif()
                if(link STREQUAL "")
                    set(link "-")
                endif()
                string(JSON err2 ERROR_VARIABLE err2 TYPE "${p}"
                    "configurePresets")
                if(NOT err2)
                    message(FATAL_ERROR
                        "Plural configurePresets of build preset "
                        "'${name}' is not supported.")
                endif()
                list(FIND bld_names "${name}" idx)
                if(NOT idx LESS 0)
                    list(REMOVE_AT bld_names ${idx})
                    list(REMOVE_AT bld_disps ${idx})
                    list(REMOVE_AT bld_hiddens ${idx})
                    list(REMOVE_AT bld_owns ${idx})
                    list(REMOVE_AT bld_pars ${idx})
                    list(REMOVE_AT bld_links ${idx})
                endif()
                list(APPEND bld_names "${name}")
                list(APPEND bld_disps "${disp}")
                list(APPEND bld_hiddens "${hid}")
                list(APPEND bld_owns "${own}")
                list(APPEND bld_pars "${par}")
                list(APPEND bld_links "${link}")
            endforeach()
        endif()
    endif()
endforeach()

# Resolve conditions along the inherits chains.
resolve_availability("${cfg_names}" "${cfg_owns}" "${cfg_pars}" cfg_avail)
resolve_availability("${bld_names}" "${bld_owns}" "${bld_pars}" bld_avail)

# Collect the visible configure presets and the pairs to run. A build
# preset is only offered when the configure preset it references is
# visible too, which is stricter than cmake --build --list-presets.
set(vis_idx "")
list(LENGTH cfg_names cfgc)
if(cfgc GREATER 0)
    math(EXPR clast "${cfgc} - 1")
    foreach(i RANGE 0 ${clast})
        list(GET cfg_hiddens ${i} hid)
        list(GET cfg_avail ${i} av)
        if(NOT hid AND av)
            list(APPEND vis_idx ${i})
        endif()
    endforeach()
endif()

set(vc_names "")
set(vc_disps "")
foreach(i ${vis_idx})
    list(GET cfg_names ${i} name)
    list(GET cfg_disps ${i} disp)
    list(APPEND vc_names "${name}")
    list(APPEND vc_disps "${disp}")
endforeach()

set(vb_names "")
set(vb_disps "")
set(pair_cfg "")
set(pair_bld "")
set(pair_short "")
list(LENGTH bld_names bldc)
math(EXPR blast "${bldc} - 1")
foreach(i ${vis_idx})
    list(GET cfg_names ${i} cname)
    list(GET cfg_disps ${i} cdisp)
    if(cdisp STREQUAL "" OR cdisp STREQUAL "__nodisp__")
        set(short "${cname}")
    else()
        set(short "${cdisp}")
    endif()
    set(paired FALSE)
    if(bldc GREATER 0)
        foreach(j RANGE 0 ${blast})
            list(GET bld_hiddens ${j} bhd)
            list(GET bld_avail ${j} bav)
            if(bhd OR NOT bav)
                continue()
            endif()
            list(GET bld_links ${j} link)
            if(NOT link STREQUAL cname)
                continue()
            endif()
            list(GET bld_names ${j} bname)
            list(GET bld_disps ${j} bdisp)
            list(APPEND vb_names "${bname}")
            list(APPEND vb_disps "${bdisp}")
            list(APPEND pair_cfg "${cname}")
            list(APPEND pair_bld "${bname}")
            list(APPEND pair_short "${short}")
            set(paired TRUE)
        endforeach()
    endif()
    if(NOT paired)
        echo_color(yellow TRUE "No build preset linked to ${cname}, skipped.")
    endif()
endforeach()

print_table("${vc_names}" "${vc_disps}" "Available configure presets:")
print_table("${vb_names}" "${vb_disps}" "Available build presets:")

# Apply the optional name filter to the run list only.
set(run_cfg "")
set(run_bld "")
set(run_short "")
list(LENGTH pair_cfg pairc)
if(pairc GREATER 0)
    math(EXPR plast "${pairc} - 1")
    foreach(k RANGE 0 ${plast})
        list(GET pair_cfg ${k} cname)
        if(CFG_FILTER AND NOT cname MATCHES "${CFG_FILTER}")
            continue()
        endif()
        list(GET pair_bld ${k} bname)
        list(GET pair_short ${k} short)
        list(APPEND run_cfg "${cname}")
        list(APPEND run_bld "${bname}")
        list(APPEND run_short "${short}")
    endforeach()
endif()

if(LIST_ONLY)
    echo_color(cyan TRUE "LIST_ONLY is set, nothing was built.")
    return()
endif()

if(NOT run_cfg)
    echo_color(yellow TRUE "No preset pair to run, nothing was built.")
    return()
endif()

# Run bi.cmake for every pair, sequentially. Each bi.cmake instance
# inherits the standard output, as bi_all.sh piped it to colorize.sh.
list(LENGTH run_cfg runc)
math(EXPR rlast "${runc} - 1")
set(run_times "")
set(failed "")
foreach(k RANGE 0 ${rlast})
    math(EXPR shown "${k} + 1")
    list(GET run_cfg ${k} cname)
    list(GET run_bld ${k} bname)
    list(GET run_short ${k} short)
    message("") # Just new line.
    echo_color(cyan TRUE "Start [${shown}/${runc}] ${cname} (${bname})...")
    string(TIMESTAMP t0 "%s")
    execute_process(
        COMMAND ${CMAKE_COMMAND}
            -D CFG_NAME:string=${cname} -D BUILD_NAME:string=${bname}
            -P ${bi_script}
        WORKING_DIRECTORY ${repo_root}
        RESULT_VARIABLE res)
    string(TIMESTAMP t1 "%s")
    math(EXPR elapsed "${t1} - ${t0}")
    list(APPEND run_times "${elapsed}")
    if(res STREQUAL "0")
        echo_color(cyan TRUE "[${short}] ${cname} finished in ${elapsed} s.")
    else()
        echo_color(yellow TRUE
            "[${short}] ${cname} failed with code ${res} after ${elapsed} s.")
        list(APPEND failed "${cname}")
    endif()
endforeach()

# Summary, as the bash matrix script printed it.
message("")
echo_color(cyan TRUE "Build times by configuration:")
foreach(k RANGE 0 ${rlast})
    math(EXPR shown "${k} + 1")
    list(GET run_short ${k} short)
    list(GET run_cfg ${k} cname)
    list(GET run_times ${k} elapsed)
    echo_color(cyan FALSE "${shown}> [${short}] ${cname}: ${elapsed} seconds")
endforeach()

string(TIMESTAMP t_end "%s")
math(EXPR elapsed_total "${t_end} - ${t_all}")
math(EXPR minutes "${elapsed_total} / 60")
math(EXPR seconds "${elapsed_total} % 60")
if(seconds LESS 10)
    set(seconds "0${seconds}")
endif()
echo_color(cyan TRUE
    "Total time: ${elapsed_total} seconds (${minutes}:${seconds}).")

if(failed)
    string(REPLACE ";" ", " failed_text "${failed}")
    message(FATAL_ERROR "Failed configure presets: ${failed_text}")
endif()
